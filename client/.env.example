# Client environment variables (VITE_ prefix exposes them to the frontend).
# Vite inlines these at build time — on Netlify they must be set in the site's
# build environment, not only at runtime.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — absolute URL for the og:url / og:image tags. Netlify supplies this
# automatically from URL / DEPLOY_PRIME_URL.
# VITE_SITE_URL=https://your-site.netlify.app

# Optional — point the dev proxy somewhere other than http://localhost:3002
# VITE_DEV_API_TARGET=http://localhost:3002

# Only needed when running the standalone Node server (`npm run dev:server`).
# On Netlify these come from the site's environment variables instead — see
# the root .env.example.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

PORT=3002

# Optional — authoritative YouTube start times
YOUTUBE_API_KEY=

# Optional production origin allowlist
# CORS_ORIGINS=https://your-site.netlify.app

# Optional API throttling override
# API_RATE_LIMIT_MAX=120

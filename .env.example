# ── Server / Netlify Function environment ─────────────────────────────────────
# On Netlify, set these in Site configuration → Environment variables.
# Locally, copy this file to .env (it is gitignored).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional — enables authoritative YouTube start times (falls back to
# client-computed synthetic values when unset).
YOUTUBE_API_KEY=

# ── Client build environment ──────────────────────────────────────────────────
# Vite inlines these at build time, so they must be present in Netlify's build
# environment, not just at runtime.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — absolute URL used in the og:url / og:image tags. Netlify sets URL
# and DEPLOY_PRIME_URL automatically, so this is only needed for a custom domain
# you want the tags to use, or for a local production build.
# VITE_SITE_URL=https://your-site.netlify.app

# ── Optional tuning ───────────────────────────────────────────────────────────
# Extra origins allowed to call the API (comma-separated). Netlify's own URL and
# deploy-preview URLs are allowed automatically.
# CORS_ORIGINS=https://your-custom-domain.com

# Extra origins allowed to embed the app in an iframe. Only used by the
# standalone Node server; on Netlify, edit frame-ancestors in netlify.toml.
# ALLOWED_FRAME_ANCESTORS=https://your-partner-site.com

# API_RATE_LIMIT_MAX=120
# YOUTUBE_LOOKUP_TIMEOUT_MS=3500
